# LLM (local via Ollama — run `ollama pull qwen3.6:latest && ollama serve` first)
OLLAMA_MODEL=qwen3.6:latest
OLLAMA_BASE_URL=http://localhost:11434

# Vector DB (Pinecone)
PINECONE_API_KEY=pcsk_zzzzz
PINECONE_INDEX=agentic-rag-index

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_zzzzz
LANGSMITH_PROJECT="Agentic RAG"

# Server security/config
PORT=3001
# Comma-separated list of allowed origins for CORS (e.g. http://localhost:5173,http://localhost:5174,https://myapp.com)
# Development: includes both Vite ports (5173 and 5174) by default
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Optional: if set, clients must send this value in the `x-api-key` header for /api/* routes
API_KEY=
# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30