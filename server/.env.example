# LLM (local via Ollama — run `ollama pull qwen2:7b && ollama serve` first)
OLLAMA_MODEL=qwen2:7b
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================
# VECTOR DATABASE CONFIGURATION
# ==============================================
# Choose your vector DB: "pinecone" (cloud) or "chroma" (local)
VECTOR_DB=chroma

# --- Option 1: CHROMA (Local — Recommended for development) ---
# Chroma provides a local vector database that runs in Docker
# No API keys needed, data stays private and offline
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=agentic-rag
EMBEDDING_MODEL=nomic-embed-text

# --- Option 2: PINECONE (Cloud) ---
# Uncomment these and set VECTOR_DB=pinecone to use Pinecone cloud
# You'll need to create a free account at https://app.pinecone.io
# PINECONE_API_KEY=pcsk_zzzzz
# PINECONE_INDEX=agentic-rag-index

# ==============================================
# LANGSMITH (Optional — for tracing/debugging)
# ==============================================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_zzzzz
LANGSMITH_PROJECT="Agentic RAG"

# ==============================================
# SERVER CONFIG
# ==============================================
PORT=3001

# CORS: comma-separated list of allowed origins
# Development: includes both Vite ports (5173 and 5174) by default
# Format: http://localhost:5173,http://localhost:5174,https://myapp.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Optional: if set, clients must send this value in the `x-api-key` header for /api/* routes
API_KEY=

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30